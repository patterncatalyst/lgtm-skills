# Multi-stage UBI 10 Containerfile for Python
# Build: podman build -f Containerfile -t my-service .
#
# Base image selection: newest UBI major with the newest Python first, then an
# older UBI major with that same Python -- never drop the Python version to
# stay on a newer UBI. Python 3.14 order:
#   1. registry.access.redhat.com/ubi10/python-314-minimal   (used below)
#   2. registry.access.redhat.com/ubi9/python-314            (fallback; full s2i image)
#      or ubi9/python-314-minimal
# UBI 10 publishes only -minimal Python images (no ubi10/python-314). Minimal
# images have no compiler: if a dependency compiles from source, add in the
# build stage `microdnf install -y gcc python3.14-devel` (as root; both
# install on 10.2-1791464217, which also ships pip).
# Re-check with: skopeo list-tags docker://registry.access.redhat.com/ubi10/python-314-minimal
# and confirm with `skopeo inspect`. Pin exact tags; bump deliberately.

# ── Stage 1: Build ──────────────────────────────────────────
FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217 AS build

# The image runs as UID 1001; the build stage needs root to write /build.
USER 0
WORKDIR /build

# Install uv into the builder stage.
RUN pip install --no-cache-dir uv==0.9.7

COPY pyproject.toml uv.lock ./
COPY src ./src

# Build a self-contained venv with only runtime dependencies.
RUN uv sync --locked --no-dev --no-editable

# ── Stage 2: Runtime ────────────────────────────────────────
FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217

WORKDIR /app

COPY --from=build --chown=1001:0 /build/.venv /app/.venv
COPY --from=build --chown=1001:0 /build/src /app/src

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    OTEL_SERVICE_NAME=my-service \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 \
    OTEL_PYTHON_LOG_CORRELATION=true

# opentelemetry-bootstrap installs the instrumentation packages matched to
# what's actually imported at runtime (fastapi, asyncpg, aiokafka, ...).
RUN opentelemetry-bootstrap -a install

EXPOSE 8080
USER 1001

ENTRYPOINT ["opentelemetry-instrument", "uvicorn", "my_service.api.main:app", \
            "--host", "0.0.0.0", "--port", "8080"]
