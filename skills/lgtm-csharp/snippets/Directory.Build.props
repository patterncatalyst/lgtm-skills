<!-- Shared build settings for every project in the repo.
     Place at the repo root; MSBuild imports the nearest Directory.Build.props
     walking up from each .csproj, so every project inherits these. -->
<Project>

  <PropertyGroup>
    <!-- .NET 10 LTS, supported to Nov 2028 -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- C# 14 with nullable reference types on everywhere -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Warnings are errors; analyzers and editorconfig style fail the build -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Deterministic, reproducible builds -->
    <Deterministic>true</Deterministic>

    <!-- Case-sensitive filesystem, LF line endings: keep project files tidy -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
