# EditorConfig for a .NET 10 / C# 14 repo. Place at the repo root.
# Applied by dotnet build (via EnforceCodeStyleInBuild) and dotnet format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml,xml}]
indent_size = 2

[*.cs]
# ── Language conventions ─────────────────────────────────────
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# ── Nullable reference types: possible-null issues fail the build ──
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8601.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# ── Quality analyzers raised to error ────────────────────────
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait: not needed in app code without a sync context
dotnet_diagnostic.CA1848.severity = suggestion  # LoggerMessage: suggest on hot paths, not force everywhere
dotnet_diagnostic.CA2016.severity = error  # forward CancellationToken
dotnet_diagnostic.CA1062.severity = warning  # validate public arguments
