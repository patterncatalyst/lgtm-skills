#!/usr/bin/env bash
#
# setup-keda.sh — install KEDA (core + HTTP add-on) into the {{PROJECT_NAME}} cluster,
# in preparation for the dual autoscalers (r26b, CAP-025):
#   * Kafka consumer-lag scaling for notification-service (core KEDA)
#   * HTTP request scaling for graphql-gateway (the HTTP add-on)
#
# Like the other {{PROJECT_NAME}} platform installs, this is run-once-per-cluster,
# separate from the app releases. Idempotent. Versions match §12.
#
# Usage (from your project root /):
#   ./scripts/setup-keda.sh
#
# Then apply the scalers:
#   kubectl apply -f keda/notification-scaledobject.yaml
#   kubectl apply -f keda/gateway-httpscaledobject.yaml
#   ./demos/smoke-keda-kafka.sh
#   ./demos/smoke-keda-http.sh

set -euo pipefail

NAMESPACE="keda"
KEDA_VERSION="${KEDA_VERSION:-2.21.0}"
KEDA_HTTP_VERSION="${KEDA_HTTP_VERSION:-0.16.0}"
# Time the interceptor holds a request for a scaled-from-zero workload to get a
# Ready replica. 0.12.x called this interceptor.replicas.waitTimeout (20s default);
# 0.14+ renamed it interceptor.readinessTimeout and the default is now disabled.
KEDA_HTTP_READINESS_TIMEOUT="${KEDA_HTTP_READINESS_TIMEOUT:-180s}"

command -v kubectl >/dev/null 2>&1 || { printf 'ERROR: kubectl not in PATH.\n' >&2; exit 1; }
command -v helm    >/dev/null 2>&1 || { printf 'ERROR: helm not in PATH — see §2.\n' >&2; exit 1; }

current_context="$(kubectl config current-context 2>/dev/null || echo "")"
if [[ "$current_context" != "{{PROJECT_NAME}}" ]]; then
    printf 'WARNING: current kubectl context is "%s", not "{{PROJECT_NAME}}".\n' "$current_context" >&2
    printf 'Switch with: kubectl config use-context {{PROJECT_NAME}}\n' >&2
    printf 'Continue anyway? [y/N] ' >&2
    read -r answer
    [[ "$answer" =~ ^[Yy] ]] || exit 1
fi

# ─── 1. kedacore helm repo ───────────────────────────────────────────────────
printf '==> Ensuring the kedacore helm repo is registered\n'
if helm repo list 2>/dev/null | grep -q '^kedacore'; then
    helm repo update kedacore >/dev/null
else
    helm repo add kedacore https://kedacore.github.io/charts
    helm repo update kedacore >/dev/null
fi

# ─── 2. KEDA core ────────────────────────────────────────────────────────────
printf '==> Installing KEDA core %s into namespace %s\n' "$KEDA_VERSION" "$NAMESPACE"
helm upgrade --install keda kedacore/keda \
    --version "$KEDA_VERSION" \
    --namespace "$NAMESPACE" \
    --create-namespace \
    --wait

# ─── 3. KEDA HTTP add-on ─────────────────────────────────────────────────────
printf '==> Installing the KEDA HTTP add-on %s into namespace %s\n' "$KEDA_HTTP_VERSION" "$NAMESPACE"
# interceptor.readinessTimeout bounds how long the interceptor holds a request
# waiting for the scaled-from-zero workload to have a Ready replica. Since 0.14
# the default is disabled and a timeout returns 504 (it was 20s / 502 in 0.12).
# Set it explicitly so a cold start (KEDA activation + image pull + Python boot
# + startupProbe) is held for a bounded time instead of forever; releasing the
# request early also starves KEDA of the stable pending-request pressure it needs
# to activate promptly. 180s covers a whole cold start.
# (interceptor.replicas.waitTimeout is a deprecated fallback in 0.16 - do not use.)
helm upgrade --install keda-add-ons-http kedacore/keda-add-ons-http \
    --version "$KEDA_HTTP_VERSION" \
    --namespace "$NAMESPACE" \
    --set-string interceptor.readinessTimeout="$KEDA_HTTP_READINESS_TIMEOUT" \
    --wait

# ─── Done ────────────────────────────────────────────────────────────────────
printf '\n==> KEDA core + HTTP add-on installed in the %s namespace.\n\n' "$NAMESPACE"
printf 'Apply the two scalers, then run the demos:\n'
printf '  kubectl apply -f keda/notification-scaledobject.yaml\n'
printf '  kubectl apply -f keda/gateway-httpscaledobject.yaml\n'
printf '  ./demos/smoke-keda-kafka.sh    # consumer-lag scaling, notification-service\n'
printf '  ./demos/smoke-keda-http.sh     # HTTP request scaling, graphql-gateway\n'
