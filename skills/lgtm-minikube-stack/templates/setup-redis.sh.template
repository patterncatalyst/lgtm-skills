#!/usr/bin/env bash
#
# setup-redis.sh — install Redis into the cluster as a cache / pub-sub store.
#
# Dev-scale install: single replica, no persistence (appendonly off), no auth.
# Data does not survive a pod restart; fine for development caching and pub/sub.
#
# For persistence, add --appendonly yes and a PVC. For auth, set --requirepass.
#
# Opt-in: only runs when ENABLE_REDIS=true.

set -euo pipefail

NS="${1:-{{PROJECT_NAME}}}"
REDIS_VERSION="${REDIS_VERSION:-7-alpine}"
RELEASE="redis"

command -v kubectl >/dev/null 2>&1 || { printf 'ERROR: kubectl not in PATH.\n' >&2; exit 1; }

kubectl create namespace "$NS" --dry-run=client -o yaml | kubectl apply -f - >/dev/null

printf '==> Installing Redis %s into namespace %s (no persistence, dev-scale)\n' \
    "$REDIS_VERSION" "$NS"

kubectl apply -n "$NS" -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: $RELEASE
  labels:
    app.kubernetes.io/name: redis
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: redis
  template:
    metadata:
      labels:
        app.kubernetes.io/name: redis
    spec:
      containers:
        - name: redis
          image: docker.io/library/redis:$REDIS_VERSION
          args: ["--save", "", "--maxmemory", "256mb", "--maxmemory-policy", "allkeys-lru"]
          ports:
            - name: redis
              containerPort: 6379
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 512Mi
          readinessProbe:
            exec:
              command: ["redis-cli", "ping"]
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            exec:
              command: ["redis-cli", "ping"]
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: $RELEASE
spec:
  selector:
    app.kubernetes.io/name: redis
  ports:
    - port: 6379
      targetPort: 6379
      name: redis
EOF

printf '==> Waiting for Redis to roll out\n'
kubectl rollout status -n "$NS" "deploy/$RELEASE" --timeout=60s

printf '\n==> Redis installed.\n\n'
printf 'Useful port-forward:\n'
printf '  kubectl port-forward -n %s svc/%s 6379:6379\n' "$NS" "$RELEASE"
printf '    redis-cli -h localhost -p 6379\n'
