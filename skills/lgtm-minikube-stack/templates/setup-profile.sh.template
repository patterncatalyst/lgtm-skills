#!/usr/bin/env bash
#
# setup-profile.sh — create (or replace) the minikube profile sized for the
# lgtm-minikube-stack.
#
# Idempotent: safe to re-run. The profile is replaceable with --replace if you
# want to start fresh (deletes the existing profile first).
#
# Host access: services are reached at 127.0.0.1:<nodePort> through NodePorts
# published to the host at cluster creation (`minikube start --ports=...`).
# No SSH tunnels, `kubectl port-forward`, or `minikube tunnel` — they disconnect.
# Published ports are FIXED at profile creation: adding a NodePort later means
# recreating the profile (./setup-profile.sh --replace, then re-run bootstrap).
#
# Usage:
#   ./setup-profile.sh             # start (or do nothing if already running)
#   ./setup-profile.sh --replace   # delete first, then start fresh
#
# Opt-in ports follow the same ENABLE_* flags as bootstrap.sh (export them, or
# bootstrap passes them through). Project app NodePorts: set
# EXTRA_NODE_PORTS="30080,30081" or edit APP_NODE_PORTS below.

set -euo pipefail
export MINIKUBE_ROOTLESS=true   # required so minikube uses rootless podman
                                # for host ops (status, ssh, registry), not sudo

PROFILE_NAME="{{PROFILE_NAME}}"
MEMORY="${MINIKUBE_MEMORY:-24g}"
CPUS="${MINIKUBE_CPUS:-16}"
DISK="${MINIKUBE_DISK:-80g}"
RUNTIME="${MINIKUBE_RUNTIME:-containerd}"
DRIVER="${MINIKUBE_DRIVER:-podman}"

# ─── Published NodePorts (host 127.0.0.1:<nodePort> -> node <nodePort>) ─────
# Keep in sync with references/ports-and-endpoints.md.
ENABLE_ISTIO="${ENABLE_ISTIO:-true}"
ENABLE_KEDA="${ENABLE_KEDA:-true}"
ENABLE_LGTM="${ENABLE_LGTM:-true}"
ENABLE_KIALI="${ENABLE_KIALI:-${ENABLE_ISTIO}}"
ENABLE_REDIS="${ENABLE_REDIS:-false}"
ENABLE_APICURIO="${ENABLE_APICURIO:-false}"
ENABLE_OPENMETADATA="${ENABLE_OPENMETADATA:-false}"
APP_NODE_PORTS=()   # project application NodePorts, e.g. (30080 30081)

NODE_PORTS=()
if [[ "$ENABLE_LGTM" == "true" ]]; then
    NODE_PORTS+=(30300 30417 30418 30009 30100 30320)  # Grafana, OTLP gRPC/HTTP, Mimir, Loki, Tempo
fi
[[ "$ENABLE_KIALI" == "true" ]]        && NODE_PORTS+=(30201)
[[ "$ENABLE_APICURIO" == "true" ]]     && NODE_PORTS+=(30084)
[[ "$ENABLE_OPENMETADATA" == "true" ]] && NODE_PORTS+=(30585)
[[ "$ENABLE_REDIS" == "true" ]]        && NODE_PORTS+=(30379)
[[ "$ENABLE_KEDA" == "true" ]]         && NODE_PORTS+=(30081)  # KEDA HTTP interceptor
NODE_PORTS+=("${APP_NODE_PORTS[@]}")
if [[ -n "${EXTRA_NODE_PORTS:-}" ]]; then
    IFS=',' read -r -a _extra <<< "$EXTRA_NODE_PORTS"
    NODE_PORTS+=("${_extra[@]}")
fi
# Bind to loopback only. Without a host IP, --ports binds 0.0.0.0 and exposes
# Grafana, the registry and app endpoints to the local network.
PORTS_ARG=""
for _p in "${NODE_PORTS[@]}"; do PORTS_ARG+="${PORTS_ARG:+,}127.0.0.1:${_p}:${_p}"; done

# Ports the node container publishes on 127.0.0.1 (docker/podman driver).
# A port bound to 0.0.0.0 does not count, so such a profile gets recreated.
published_ports() {
    "${MINIKUBE_DRIVER:-docker}" inspect -f '{{json .HostConfig.PortBindings}}' "$PROFILE_NAME" 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin) or {}
except Exception:
    d = {}
print("\n".join(sorted({b["HostPort"] for v in d.values() for b in (v or []) if b.get("HostPort") and b.get("HostIp") == "127.0.0.1"})))
' 2>/dev/null
}

REPLACE=0
if [[ "${1:-}" == "--replace" ]]; then
    REPLACE=1
fi

# ─── Pre-flight: required tools ─────────────────────────────────────────────
require_tool() {
    local tool="$1"
    local hint="$2"
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'ERROR: %s is not in PATH.\n' "$tool" >&2
        printf '  %s\n' "$hint" >&2
        exit 1
    fi
}

require_tool minikube 'Install minikube: https://minikube.sigs.k8s.io/docs/start/'
require_tool kubectl  'Install kubectl: https://kubernetes.io/docs/tasks/tools/'
require_tool helm     'Install helm: https://helm.sh/docs/intro/install/'
require_tool podman   'Install podman: https://podman.io/docs/installation'

# ─── Pre-flight: kernel limits ──────────────────────────────────────────────
# Many controllers + many pods = many inotify watches. Fedora's default
# fs.inotify.max_user_instances=128 is insufficient for this stack.
inotify_instances=$(sysctl -n fs.inotify.max_user_instances 2>/dev/null || echo 0)
if (( inotify_instances < 256 )); then
    printf 'ERROR: fs.inotify.max_user_instances is %d (need >= 256).\n' "$inotify_instances" >&2
    printf 'Apply this kernel-limits tweak before continuing:\n' >&2
    printf '  sudo tee /etc/sysctl.d/99-kubernetes.conf <<EOF\n' >&2
    printf '  fs.inotify.max_user_instances = 512\n' >&2
    printf '  fs.inotify.max_user_watches = 524288\n' >&2
    printf '  EOF\n' >&2
    printf '  sudo sysctl -p /etc/sysctl.d/99-kubernetes.conf\n' >&2
    exit 1
fi

# ─── Pre-flight: podman pids_limit ──────────────────────────────────────────
# The podman driver creates the minikube node as a container whose root cgroup
# pids.max is podman's default (--pids-limit=2048). The full stack runs ~2000+
# tasks and saturates 2048 — kubelet then can't fork the last pod's init
# (EAGAIN, runc exit 128, "resource temporarily unavailable", CrashLoopBackOff).
# The node-container cgroup pids.max is NOT writable live on a rootless node,
# so the only durable fix is at CREATION time: raise podman's default via
# containers.conf BEFORE the node is built.
pids_limit=$(
    grep -hsE '^[[:space:]]*pids_limit[[:space:]]*=' \
        "${HOME}/.config/containers/containers.conf" \
        /etc/containers/containers.conf 2>/dev/null \
        | tail -1 | grep -oE '[0-9]+' | tail -1 || true
)
pids_limit="${pids_limit:-2048}"
pids_too_low=0
if [[ "$pids_limit" != "0" ]] && [[ "$pids_limit" =~ ^[0-9]+$ ]]; then
    if (( pids_limit < 8192 )); then pids_too_low=1; fi
fi
if [[ "$pids_too_low" == "1" ]]; then
    printf 'ERROR: podman default pids_limit is %s (need 0=unlimited or >= 8192).\n' "$pids_limit" >&2
    printf 'The node would be capped at %s PIDs and the last pod would fail to fork.\n' "$pids_limit" >&2
    printf 'Raise it before creating the node:\n' >&2
    printf '  mkdir -p ~/.config/containers\n' >&2
    printf "  printf '[containers]\\\npids_limit = 0\\\n' >> ~/.config/containers/containers.conf\n" >&2
    printf 'Then re-run this script (a node recreate is needed to pick it up).\n' >&2
    exit 1
fi
if [[ "$pids_limit" == "0" ]]; then
    pids_display="unlimited"
else
    pids_display="$pids_limit"
fi
printf '==> podman pids_limit OK (%s)\n' "$pids_display"

# ─── Pre-flight: other minikube profiles ───────────────────────────────────
running_profiles=$(minikube profile list -o json 2>/dev/null \
    | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    for p in data.get("valid", []):
        if p["Name"] != "'"$PROFILE_NAME"'" and p.get("Status") == "Running":
            print(p["Name"])
except Exception:
    pass
' 2>/dev/null || true)

if [[ -n "$running_profiles" ]]; then
    printf 'WARNING: other minikube profiles are running and will compete for RAM:\n' >&2
    printf '%s\n' "$running_profiles" | sed 's/^/  - /' >&2
    printf 'Recommended: stop them with `minikube stop -p <name>` before continuing.\n' >&2
    printf 'Continue anyway? [y/N] ' >&2
    read -r answer
    [[ "$answer" =~ ^[Yy] ]] || exit 1
fi

# ─── Profile setup ─────────────────────────────────────────────────────────
if minikube status -p "$PROFILE_NAME" >/dev/null 2>&1; then
    if (( REPLACE )); then
        printf '==> Deleting existing %s profile (--replace specified)\n' "$PROFILE_NAME"
        minikube delete -p "$PROFILE_NAME"
    else
        missing="$(comm -13 <(published_ports | sort) <(printf '%s\n' "${NODE_PORTS[@]}" | sort) | tr '\n' ' ')"
        if [[ -n "${missing// /}" ]]; then
            printf 'ERROR: profile %s does not publish these ports on 127.0.0.1: %s\n' "$PROFILE_NAME" "$missing" >&2
            printf '  Ports are fixed at creation. Recreate: ./setup-profile.sh --replace\n' >&2
            exit 1
        fi
        printf '==> Profile %s already exists and is running. Pass --replace to recreate.\n' "$PROFILE_NAME"
        printf '    (Published NodePorts are fixed at creation; new ports need --replace.)\n'
        printf '==> Switching kubectl context to %s\n' "$PROFILE_NAME"
        kubectl config use-context "$PROFILE_NAME"
        printf '==> Done. Current nodes:\n'
        kubectl get nodes
        exit 0
    fi
fi

printf '==> Publishing NodePorts to 127.0.0.1: %s\n' "$PORTS_ARG"
printf '==> Starting %s profile (%s RAM, %s CPUs, %s disk, %s runtime)\n' \
    "$PROFILE_NAME" "$MEMORY" "$CPUS" "$DISK" "$RUNTIME"

minikube start -p "$PROFILE_NAME" \
    --memory="$MEMORY" \
    --cpus="$CPUS" \
    --disk-size="$DISK" \
    --container-runtime="$RUNTIME" \
    --driver="$DRIVER" \
    --rootless=true \
    --ports="$PORTS_ARG" \
    --addons=metrics-server

printf '==> Switching kubectl context to %s\n' "$PROFILE_NAME"
kubectl config use-context "$PROFILE_NAME"

printf '==> Verifying cluster health\n'
kubectl get nodes
kubectl get pods -n kube-system

printf '==> Persisting rootless mode in minikube config\n'
minikube config set rootless true >/dev/null 2>&1 || true

printf '==> Enabling the in-cluster registry addon\n'
minikube addons enable registry -p "$PROFILE_NAME"
printf '    Host pushes to 127.0.0.1:<port> (see: podman port %s | grep 5000)\n' "$PROFILE_NAME"

printf '\n'
printf '==> Profile is ready.\n'
printf '\n'
printf 'Next steps:\n'
printf '  ./scripts/bootstrap.sh             # bring up the full stack\n'
printf '  ./scripts/teardown.sh              # delete this profile\n'
